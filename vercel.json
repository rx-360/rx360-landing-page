{
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.ts": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!assets/|favicon\\.png|opengraph\\.(png|jpg|jpeg)|.*\\.(js|css|ico|svg|woff2?|ttf|eot)).*)", "destination": "/index.html" }
  ]
}
